<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tapziq" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Tapziq.Proofread" parent="Theme.Tapziq">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
